[Unit]
Description=Crypto Robot Read-only Dashboard API
After=binance-execution.service
Requires=binance-execution.service

[Service]
Type=simple
User=binance-exec
Group=binance-exec
WorkingDirectory=/opt/crypto-robot
EnvironmentFile=/etc/crypto-robot/binance-execution.env
ExecStart=/usr/bin/python3 /opt/crypto-robot/execution/dashboard_proxy.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
