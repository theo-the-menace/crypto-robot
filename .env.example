# Start with Spot Testnet credentials from https://testnet.binance.vision/
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Local browser dashboard access. This remains in .env and is never committed.
VITE_DASHBOARD_API_URL=http://43.163.91.179:8888
VITE_DASHBOARD_TOKEN=
VITE_MARKET_API_URL=https://yeatom.site:8443

# Independent server-side limits. This first version supports USDT spot pairs only.
# Use * and 0 for the maximum client-side capability boundary. Binance filters,
# balance checks, rate limits, and exchange-side permissions still apply.
BINANCE_SYMBOLS=*
MAX_ORDER_USDT=0

# Optional. Without OpenAI, explicit Chinese/English market commands still work.
# OpenAI-compatible endpoint. The server appends /v1/chat/completions.
OPENAI_VIP_BASE_URL=https://api.vipapi.ai:99
OPENAI_VIP_API_KEY=
OPENAI_VIP_MODEL=gpt-5.6-luna
OPENAI_VIP_REASONING_EFFORT=medium
# Optional dedicated market data service. When omitted, the app reuses
# OPENAI_VIP_BASE_URL and OPENAI_VIP_API_KEY.
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=
MARKET_MESSAGES_BASE_URL=
MARKET_MESSAGES_API_KEY=
# Required by `npm run download:market-data`. This URL must expose the
# unpacked contents of data/market/, including BTCUSD_PERP/1m/manifest.json.
MARKET_DATA_DOWNLOAD_URL=http://43.163.91.179:8888/v1/market-data

# Live mode requires BINANCE_ENV=live and this second explicit unlock.
# Never enable withdrawals on this API key. Restrict it by IP.
BINANCE_LIVE_TRADING=false

# Gmail inbound mail (server-side OAuth + Google Cloud Pub/Sub push)
# Create a Web application OAuth client and set its exact callback URL.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://yeatom.site:8443/api/gmail/oauth/callback
GMAIL_USER=me
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-events
GMAIL_PUBSUB_TOKEN=
GMAIL_LLM_BASE_URL=
GMAIL_LLM_API_KEY=
GMAIL_LLM_MODEL=gpt-5.6-luna
GMAIL_LLM_DIRECT=false
GMAIL_RELEVANCE_MODEL=gpt-5.6-luna
GMAIL_ANALYSIS_MODEL=gpt-5.6-terra
WHITEHOUSE_RELEVANCE_MODEL=gpt-5.6-luna
WHITEHOUSE_ANALYSIS_MODEL=gpt-5.6-terra
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SOCIALDATA_API_KEY=
CONGRESS_API_KEY=
CONGRESS_RELEVANCE_MODEL=gpt-5.6-luna
PROVIDER_TIMEOUT_MS=180000
PROVIDER_CHAIN_TIMEOUT_MS=180000
# Optional remote API health-check target. Local Vite requests always use the local API.
CRYPTO_AGENT_REMOTE_API_URL=
# Optional local API override for development (defaults to http://127.0.0.1:8889).
CRYPTO_AGENT_LOCAL_API_URL=
