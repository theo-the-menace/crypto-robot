{
  "name": "@evolving-agents/crypto-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "exports": "./src/binance.mjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "desktop": "concurrently -k \"npm:dev:api\" \"npm:dev:web\" \"wait-on http://127.0.0.1:8888 && CRYPTO_AGENT_DEV_SERVER=1 electron .\"",
    "dist:mac": "npm run build && electron-builder --mac",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node --test test/*.test.mjs server/*.test.mjs && python3 -m unittest execution/test_binance_execution_service.py",
    "check": "node --check src/*.mjs server/*.mjs test/*.mjs server/*.test.mjs && python3 -m py_compile execution/binance_execution_service.py && tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "wait-on": "latest"
  },
  "engines": {
    "node": ">=22.5"
  },
  "build": {
    "appId": "com.evolvingagents.cryptoagent",
    "productName": "CryptoAgent",
    "files": ["dist/**/*", "electron/**/*", "server/**/*", "src/**/*.mjs", "package.json", "node_modules/**/*"],
    "asarUnpack": ["server/**/*", "src/**/*.mjs"],
    "mac": { "category": "public.app-category.finance", "target": ["dmg", "dir"] }
  }
}
